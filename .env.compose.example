# Copy to .env. These credentials are for an isolated localhost installation.
REGISTRY_API_TOKEN=cv-local-registry-token
FACTS_PUBLISH_TOKEN=cv-local-facts-publish-token
POSTGRES_PASSWORD=cv-local-postgres-password
MINIO_ACCESS_KEY_ID=cv-local
MINIO_SECRET_ACCESS_KEY=cv-local-minio-password
NATS_PASSWORD=cv-local-nats-password

# Use localhost consistently: the CV URL must be identical for the host and Chromium.
REGISTRY_PORT=4300
REGISTRY_API_PORT=3001
CV_PORT=4381
MINIO_CONSOLE_PORT=9001

# Optional renderer demo. This does not import a Reviewed facts catalogue.
CV_FIXTURE_MODE=0
